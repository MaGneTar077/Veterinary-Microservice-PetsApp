# Copia este archivo a .env para desarrollo local. En Cloud Run, las variables marcadas
# SECRETO van como referencia a Secret Manager ("Referenciar un secreto"), no como variable
# normal. No dejes espacios antes ni después de los valores.
#
# Fuente de verdad: src/main/resources/application.yaml + @Value/@ConfigurationProperties en
# src/main/java. Si agregás una variable nueva al código, agregala también acá.
#
# PORT no está en este archivo: Cloud Run la inyecta solo (con el valor del campo "Puerto del
# contenedor" del servicio) y gana sobre SERVER_PORT. No la definas vos mismo en Cloud Run.

# ============================================================
# Base de datos (Supabase Postgres)
# ============================================================

# DB_URL
# Qué es: URL JDBC de Postgres. OBLIGATORIA. Sin default.
# Si falta: la app NO ARRANCA (Hikari no puede resolver spring.datasource.url).
# SECRETO (el host ya identifica el proyecto de Supabase).
#
# Usá el Transaction pooler de Supabase (puerto 6543, no el 5432 directo) — es el que
# soporta la cantidad de conexiones cortas que genera Cloud Run escalando instancias.
# Termina la URL en `?prepareThreshold=0`: el Transaction pooler (PgBouncer) no mantiene la
# misma conexión física entre una preparación de statement y su ejecución, así que el
# pgjdbc intenta reusar un "prepared statement" que PgBouncer ya reasignó a otra sesión —
# eso produce el error intermitente "prepared statement \"S_1\" already exists".
# `prepareThreshold=0` le dice al driver que nunca prepare statements del lado del servidor,
# evitándolo por completo. Verificado: ni application.yaml ni la documentación anterior
# (CLAUDE.md, DEPLOY_CLOUD_RUN.md) traían este parámetro — agregalo ahora si no lo tenías.
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0

# DB_USERNAME
# Qué es: usuario de la base. Con el Transaction pooler de Supabase es "postgres.<project-ref>"
# (no solo "postgres"). OBLIGATORIA. Sin default. SECRETO.
# Si falta: no arranca.
DB_USERNAME=

# DB_PASSWORD
# Qué es: password de la base. OBLIGATORIA. Sin default. SECRETO.
# Si falta: no arranca.
DB_PASSWORD=

# ============================================================
# Pool de conexiones (HikariCP)
# ============================================================
# application.yaml no fija maximum-pool-size ni connection-timeout, así que sin estas dos
# variables Hikari corre con los defaults de la librería (pool de 10, timeout de 30000 ms).
# Spring Boot las toma automáticamente por "relaxed binding" (SPRING_DATASOURCE_HIKARI_X ->
# spring.datasource.hikari.x) sin tocar application.yaml ni el código.

# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE
# Qué es: máximo de conexiones que este servicio abre a la base, por instancia. OPCIONAL.
# Default de Hikari si no se define: 10.
# Si falta: vuelve al default de 10 — riesgoso con varias instancias de Cloud Run a la vez,
# porque el Transaction pooler de Supabase tiene un cupo de conexiones COMPARTIDO entre
# todos los servicios e instancias del proyecto (no solo este). Bajalo a un número chico por
# instancia (3) para dejarle cupo a los demás servicios.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=3

# SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT
# Qué es: milisegundos que una petición espera por una conexión libre del pool antes de
# fallar. OPCIONAL. Default de Hikari si no se define: 30000 (30 segundos).
# Si falta: con el pool agotado (varias instancias compitiendo por el cupo del pooler), una
# petición puede quedar colgada hasta 30 segundos antes de fallar con un 500 — exactamente el
# síntoma que motivó este archivo: una subida de documento tardaba ~30s antes del error.
# Bajarlo a 8000 hace que falle rápido en vez de colgar al usuario.
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=8000

# ============================================================
# JWT (validación de tokens del User service)
# ============================================================

# JWT_JWKS_URI
# Qué es: URL del JWKS del User service, usada por NimbusJwtDecoder para validar la firma de
# cada token. OBLIGATORIA. Sin default. No es secreto (es una URL pública).
# Si falta: NO ARRANCA (spring.security.oauth2.resourceserver.jwt.jwk-set-uri no se resuelve).
JWT_JWKS_URI=https://user-service-xxxx.run.app/.well-known/jwks.json

# INTERNAL_API_KEY
# Qué es: llave compartida para el header X-Internal-Api-Key en las rutas /internal/**.
# Tiene que ser IDÉNTICA en todos los servicios que se llaman entre sí. OBLIGATORIA.
# Sin default. SECRETO.
# Si falta: no arranca (InternalApiKeyFilter la pide en el constructor).
INTERNAL_API_KEY=

# ============================================================
# Supabase Storage (archivos: logo, documentos de verificación, firma)
# ============================================================

# SUPABASE_URL
# Qué es: URL del proyecto de Supabase (la misma base que DB_URL, pero la REST API, no la
# conexión JDBC). OBLIGATORIA. Sin default. No es secreto (es la URL pública del proyecto).
# Si falta: no arranca (SupabaseStorageAdapter la necesita en el constructor).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# SUPABASE_KEY
# Qué es: API key de Supabase usada para subir/borrar/firmar archivos en Storage.
# OBLIGATORIA. Sin default. SECRETO.
# TIENE QUE SER LA "service_role", NUNCA LA "anon": el adaptador sube a un bucket privado y
# genera URLs firmadas; con la anon esas dos operaciones fallan con 403, que este servicio
# traduce a 503 EXTERNAL_SERVICE_UNAVAILABLE en cualquier subida o borrado de archivo.
# (Ojo: CLAUDE.md dice "anon key" en una tabla vieja — es un error de esa tabla, no de esta.)
# Si falta: no arranca.
SUPABASE_KEY=

# APP_STORAGE_LOGOS_BUCKET
# Qué es: nombre del bucket público de logos. OPCIONAL. Default: veterinary-logos.
# Si falta: usa el default — normalmente no hace falta tocarlo. El bucket se crea a mano en
# el panel de Supabase, el servicio no lo crea.
APP_STORAGE_LOGOS_BUCKET=veterinary-logos

# APP_STORAGE_VERIFICATION_BUCKET
# Qué es: nombre del bucket privado de documentos de verificación. OPCIONAL.
# Default: verification-documents.
# Si falta: usa el default. Mismo comentario que el anterior.
APP_STORAGE_VERIFICATION_BUCKET=verification-documents

# ============================================================
# Servicios (comunicación con User service y registros oficiales)
# ============================================================

# USER_SERVICE_URL
# Qué es: base URL del User service, usada para resolver nombre/correo de usuarios
# (GET {USER_SERVICE_URL}/internal/users/{id}). RECOMENDADA, no obligatoria para arrancar.
# Default: vacío.
# Si falta: arranca igual. Sin ella, esas llamadas fallan y los campos que dependen de ellas
# caen a su fallback (p. ej. "account" del detalle admin -> solo { id }; nombre/correo en la
# lista de empleados -> null). Nada se cae, pero el frontend ve menos datos.
USER_SERVICE_URL=https://user-service-xxxx.run.app

# RUES_URL
# Qué es: URL del Registro Único Empresarial y Social, mostrada al admin para verificar una
# clínica (registryLookupUrl cuando el sujeto es CLINIC). OPCIONAL.
# Default: https://www.rues.org.co/
# Si falta: usa el default.
RUES_URL=https://www.rues.org.co/

# COMVEZCOL_URL
# Qué es: URL del Consejo Profesional de Medicina Veterinaria y Zootecnia, mostrada al admin
# para verificar un profesional (registryLookupUrl cuando el sujeto es PROFESSIONAL). OPCIONAL.
# Default: https://consejoprofesionalmvz.gov.co/consulta-de-profesionales/
# Si falta: usa el default.
COMVEZCOL_URL=https://consejoprofesionalmvz.gov.co/consulta-de-profesionales/

# ============================================================
# Eventos (Google Cloud Pub/Sub)
# ============================================================

# EVENTS_ENABLED
# Qué es: activa/desactiva la publicación de eventos (y, con ella, toda la autoconfiguración
# de GCP Pub/Sub). OPCIONAL. Default: true.
# Si falta (queda en true) y además falta GCP_PROJECT_ID: la app NO ARRANCA — la
# autoconfiguración de spring-cloud-gcp-starter-pubsub intenta construir un PublisherFactory
# real y falla con "The project ID can't be null or empty". En desarrollo local y mientras no
# haya un proyecto GCP real conectado, dejalo en false.
EVENTS_ENABLED=false

# GCP_PROJECT_ID
# Qué es: proyecto de Google Cloud para Pub/Sub. Obligatoria SOLO si EVENTS_ENABLED=true
# contra un proyecto real. Default: vacío.
# Si falta con EVENTS_ENABLED=true: no arranca (ver arriba).
GCP_PROJECT_ID=

# ============================================================
# IA (verificación automática de documentos)
# ============================================================

# AI_VERIFICATION_ENABLED
# Qué es: prende el análisis de documentos por IA tras enviar una verificación. OPCIONAL.
# Default: false.
# Si falta (queda en false): se registra un adaptador NoOp, ai_status queda siempre NOT_RUN,
# y POST .../rerun-ai responde 409 AI_VERIFICATION_DISABLED. La app arranca igual.
AI_VERIFICATION_ENABLED=false

# IA_SERVICE_URL
# Qué es: URL del servicio de IA de verificación. Obligatoria SOLO si
# AI_VERIFICATION_ENABLED=true. Default: vacío.
# Si falta con la IA prendida: las llamadas al servicio de IA fallan (no impide arrancar,
# pero el análisis nunca se completa).
IA_SERVICE_URL=

# ============================================================
# Correo / soporte
# ============================================================

# SUPPORT_EMAIL
# Qué es: destinatario del evento VERIFICATION_SUBMITTED (a quién le llega el aviso de que
# hay una clínica nueva para revisar). OPCIONAL. Default: vacío.
# Si falta: el evento sale con recipient.email vacío — inofensivo si EVENTS_ENABLED=false,
# pero con eventos prendidos nadie recibe el aviso.
SUPPORT_EMAIL=soporte@myanimalog.com

# ============================================================
# Frontend (valores que el frontend tiene que conocer o igualar)
# ============================================================

# APP_BASE_URL
# Qué es: base pública del propio servicio (o del dominio que la expone), usada para construir
# el inviteLink de clientes (código de invitación de la clínica). OBLIGATORIA. Sin default.
# Si falta: no arranca.
APP_BASE_URL=https://app.myanimalog.com

# INVITATION_BASE_URL
# Qué es: ruta del frontend web que recibe el token de invitación de PERSONAL (Fase 3). El
# enlace del correo se arma como "{INVITATION_BASE_URL}?token=<token>". OPCIONAL para que la
# app arranque, pero prácticamente obligatoria para que la invitación de personal sirva de algo.
# Default: vacío.
# Si falta: la app arranca, pero el enlace del correo sale como "?token=..." sin dominio —
# inservible para el usuario que lo recibe.
INVITATION_BASE_URL=https://app.myanimalog.com/equipo/invitacion

# LEGAL_DATA_POLICY_VERSION
# Qué es: versión vigente del consentimiento de tratamiento de datos que el frontend tiene
# que mandar en RegisterVeterinary (acceptedDataPolicyVersion). OPCIONAL.
# Default: 2026-10-v1.
# Si falta: usa el default. Si el frontend manda una versión distinta a esta: 409
# CONSENT_VERSION_OUTDATED.
LEGAL_DATA_POLICY_VERSION=2026-10-v1

# LEGAL_TERMS_VERSION
# Qué es: versión vigente de términos y condiciones (acceptedTermsVersion). OPCIONAL.
# Default: 2026-10-v1.
# Si falta: usa el default. Mismo comportamiento que la anterior si no coincide.
LEGAL_TERMS_VERSION=2026-10-v1

# ============================================================
# Puerto (solo desarrollo local)
# ============================================================

# SERVER_PORT
# Qué es: puerto HTTP cuando corrés el servicio en tu máquina. OPCIONAL. Default: 8082.
# Si falta: usa 8082.
# NO la definas en Cloud Run: ahí manda PORT (la inyecta Cloud Run automáticamente según el
# campo "Puerto del contenedor" del servicio) y SERVER_PORT quedaría mintiendo sin efecto real
# (server.port: ${PORT:${SERVER_PORT:8082}} — PORT siempre gana si está presente).
SERVER_PORT=8082
